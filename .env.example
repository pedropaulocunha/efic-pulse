# Copie para .env.local e preencha. Nunca coloque aqui a chave secreta do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IA (OpenAI) — só no servidor, nunca com NEXT_PUBLIC_. Ver docs/ia-temas-nuvem.md.
OPENAI_API_KEY=
# Opcional: modelo da OpenAI (padrão gpt-4o).
OPENAI_MODEL=
